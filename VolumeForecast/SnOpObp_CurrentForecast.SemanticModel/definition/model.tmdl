model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectQuery to AS - SnOpObp_CurrentForecast"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table factSnOPdata
ref table paramViewOption
ref table paramTimeOption
ref table _metrics
ref table dimStages
ref table factGDPW
ref table dimUnits
ref table 'OBP TS KF Mapping'

ref cultureInfo en-US

